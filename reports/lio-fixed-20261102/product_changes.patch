+actual = Rotation.from_quat([getattr(msg.pose.pose.orientation, k) for k in "xyzw"])
+assert ((rotation * mount).inv() * actual).magnitude() < 1e-12
+np.testing.assert_allclose([getattr(msg.twist.twist.linear, k) for k in "xyz"],
