  <maintainer email="zenith@example.com">ZAV</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>rclpy</depend><depend>ommpc_core</depend>
